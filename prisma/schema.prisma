generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VelocityClass {
  FAST
  MEDIUM
  SLOW
}

enum AreaType {
  FRONT_HOME
  BACKSTOCK
  FLEX_RESERVE
  OVERFLOW
  RECEIVING
}

enum LocationStatus {
  OPEN
  OCCUPIED_HOME_SKU
  OCCUPIED_OVERFLOW_SKU
  RESERVED_HOME_SLOT
  OPEN_FLEX_SLOT
  BLOCKED
}

enum PalletStatus {
  AVAILABLE
  IN_TRANSIT
  CONSUMED
  HOLD
}

enum MoveReasonCode {
  STANDARD_MOVE
  INBOUND_PUTAWAY
  OVERFLOW_RELOCATION
  RECLAIM_HOME_SLOT
  CONSOLIDATION
  ADJUSTMENT
}

enum InboundReceiptStatus {
  OPEN
  PARTIALLY_PLACED
  PLACED
  CANCELLED
}

model Sku {
  id                       String   @id @default(cuid())
  partNumber               String   @unique
  description              String
  velocityClass            VelocityClass
  productFamily            String?
  palletsPerFullAllocation Int
  active                   Boolean  @default(true)
  lotNumber                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  homeLocations   Location[]
  pallets         Pallet[]
  moveTransactions MoveTransaction[]
  inboundReceipts InboundReceipt[]

  @@index([velocityClass])
  @@index([productFamily])
}

model WarehouseArea {
  id        String   @id @default(cuid())
  name      String   @unique
  areaType  AreaType
  sortOrder Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]

  @@index([areaType])
}

model Location {
  id               String         @id @default(cuid())
  areaId           String
  zone             String
  aisle            String
  bay              String
  level            String
  depthPosition    Int
  fullLocationCode String         @unique
  homeSkuId        String?
  isFrontHomeSlot  Boolean        @default(false)
  isFlexSlot       Boolean        @default(false)
  allowsOverflow   Boolean        @default(false)
  status           LocationStatus @default(OPEN)
  partNumberStart  String?
  partNumberEnd    String?
  travelSequence   Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  area    WarehouseArea @relation(fields: [areaId], references: [id])
  homeSku Sku?          @relation(fields: [homeSkuId], references: [id])

  currentPallet  Pallet?
  fromMoves      MoveTransaction[] @relation("MoveFromLocation")
  toMoves        MoveTransaction[] @relation("MoveToLocation")

  @@index([areaId])
  @@index([zone, aisle, bay])
  @@index([homeSkuId])
  @@index([status])
  @@index([isFrontHomeSlot, isFlexSlot, allowsOverflow])
}

model Pallet {
  id                  String       @id @default(cuid())
  palletLicensePlate  String       @unique
  skuId               String
  quantity            Int
  receivedAt          DateTime
  currentLocationId   String?      @unique
  status              PalletStatus @default(AVAILABLE)
  inboundReceiptId    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  sku             Sku             @relation(fields: [skuId], references: [id])
  currentLocation Location?       @relation(fields: [currentLocationId], references: [id])
  inboundReceipt  InboundReceipt? @relation(fields: [inboundReceiptId], references: [id])
  moves           MoveTransaction[]

  @@index([skuId])
  @@index([currentLocationId])
  @@index([status])
}

model MoveTransaction {
  id             String         @id @default(cuid())
  palletId       String
  skuId          String
  fromLocationId String?
  toLocationId   String?
  movedBy        String
  movedAt        DateTime       @default(now())
  reasonCode     MoveReasonCode
  notes          String?

  pallet       Pallet    @relation(fields: [palletId], references: [id])
  sku          Sku       @relation(fields: [skuId], references: [id])
  fromLocation Location? @relation("MoveFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("MoveToLocation", fields: [toLocationId], references: [id])

  @@index([palletId])
  @@index([skuId])
  @@index([movedAt])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model InboundReceipt {
  id          String               @id @default(cuid())
  skuId       String
  palletQty   Int
  receivedBy  String
  receivedAt  DateTime             @default(now())
  status      InboundReceiptStatus @default(OPEN)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  sku     Sku      @relation(fields: [skuId], references: [id])
  pallets Pallet[]

  @@index([skuId])
  @@index([status])
  @@index([receivedAt])
}
