{
  "name": "warehouse-inventory-mapping-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config client/vite.config.ts --host 127.0.0.1",
    "build": "npm run build:services && npm run build:web",
    "build:services": "tsc",
    "build:web": "vite build --config client/vite.config.ts",
    "preview:web": "vite preview --config client/vite.config.ts --host 127.0.0.1",
    "test": "npm run test:move-destinations",
    "test:move-destinations": "tsx src/services/moveDestinationService.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
